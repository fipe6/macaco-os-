# Copia este archivo a .env.local y completa los valores

# URL base de tu instancia de n8n (sin / al final)
# Ejemplo: https://n8n.tudominio.com
VITE_N8N_BASE_URL=

# Token opcional para autenticar webhooks (header Authorization: Bearer ...)
# Si tus webhooks de n8n usan "Header Auth", pon el valor aquí
VITE_N8N_TOKEN=
