# Copia este archivo a .env.local y completa los valores

# ─── n8n ────────────────────────────────────────────────────────────────────
# URL base de tu instancia de n8n (sin / al final)
VITE_N8N_BASE_URL=
# Token opcional para autenticar webhooks
VITE_N8N_TOKEN=

# ─── Supabase (persistencia de datos operacionales) ─────────────────────────
# Encuéntralos en: supabase.com → tu proyecto → Settings → API
# Project URL (ej: https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# anon / public key (NO la service_role key)
VITE_SUPABASE_ANON_KEY=
